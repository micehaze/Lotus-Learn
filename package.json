{
  "name": "lotus-learn",
  "version": "5.0.0",
  "private": true,
  "description": "LotusLearn: Tamil, Malayalam, Kannada and Telugu learning with a free, fully local dictionary (IndicTrans2, Wiktionary, Wikidata, Ollama).",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node tools/start-all.mjs",
    "dev": "node --disable-warning=ExperimentalWarning --watch-path=server --watch-path=shared server/index.js",
    "seed": "node --disable-warning=ExperimentalWarning server/scripts/seed.js",
    "create-admin": "node --disable-warning=ExperimentalWarning server/scripts/create-admin.js",
    "backup": "node --disable-warning=ExperimentalWarning server/scripts/backup.js",
    "art": "node tools/build-art.mjs",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 \"tests/unit/*.test.js\" \"tests/integration/*.test.js\"",
    "test:e2e": "node tools/python.mjs tests/e2e/run_e2e.py",
    "check": "node tools/check.mjs",
    "dict:plan": "node tools/python.mjs local-dictionary/setup_local_dictionary.py --dry-run",
    "dict:setup": "node tools/python.mjs local-dictionary/setup_local_dictionary.py",
    "dict:start": "node tools/python.mjs -m lotus_dict.server",
    "dict:verify": "node tools/python.mjs local-dictionary/verify_local.py",
    "dict:test": "node tools/python.mjs -m unittest discover -s local-dictionary/tests -v",
    "start:all": "node tools/start-all.mjs",
    "start:web": "node --disable-warning=ExperimentalWarning server/index.js",
    "daily-topic:generate": "node --disable-warning=ExperimentalWarning server/scripts/daily-topic-generate.js",
    "test:daily-topic": "node --disable-warning=ExperimentalWarning --test tests/integration/daily-topic-automation.test.js"
  }
}
