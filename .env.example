# Lotus Learn configuration. Copy to .env and edit. Every value is optional.

# --- server
PORT=3005
HOST=127.0.0.1
# Public base URL, used in password-reset links
PUBLIC_URL=http://localhost:3005
# SQLite database file (created automatically)
DATABASE_FILE=data/lotus.db
# Set to true when served over HTTPS
SECURE_COOKIES=false
SESSION_DAYS=30
# Login/registration attempts per IP per 15 minutes
AUTH_RATE_LIMIT=20

# --- accounts
# This email becomes an administrator when it registers
ADMIN_EMAIL=
# Create the demo learner + demo admin on first start (development only)
SEED_DEMO_USER=false

# --- content automation (background scheduler)
AUTOMATION_ENABLED=false
AUTOMATION_INTERVAL_MINUTES=30

# --- Optional local AI (Ollama). NOT required: with these empty, every feature works offline:
#   Daily Topic lists come from the word library + offline dictionary, practice stories come from built-in
#   templates, dictionary entries are filled from Wiktionary/Wikipedia sources, and editors write lessons.
# To add AI-generated stories, grammar lessons and richer word lists, install https://ollama.com,
# run `ollama pull gemma3:4b` (and/or qwen3:4b), then set the model names below.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=

DAILY_TOPIC_ENABLED=true
# Leave empty to build Daily Topic lists offline. Set e.g. qwen3:4b to let a local model help.
DAILY_TOPIC_MODEL=
DAILY_TOPIC_TARGET=30
DAILY_TOPIC_TIMEOUT_MS=300000
# Smaller model requests can be useful on CPU-only machines.
# DAILY_TOPIC_BATCH_SIZE=5
# DAILY_TOPIC_SIMILARITY_WINDOW=365
# Omit for the machine's IANA timezone. The first zone is pinned in the database.
# APP_TIMEZONE=Asia/Bangkok
AI_TIMEOUT_MS=300000

# --- Optional YouTube Data API discovery. Curated and manually added links require no key.
YOUTUBE_API_KEY=

# --- email for password resets (optional; default prints the link in the server console)
# MAIL_PROVIDER=console | resend
RESEND_API_KEY=
MAIL_FROM=Lotus Learn <no-reply@yourdomain.example>

# --- Free local dictionary service (local-dictionary/): IndicTrans2 + Wiktionary/Kaikki + Wikidata Lexemes + Ollama
LOCAL_DICT_URL=http://127.0.0.1:8766
LOCAL_DICT_ENABLED=true
LOCAL_DICT_TIMEOUT_MS=120000
